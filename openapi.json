{
  "openapi": "3.0.3",
  "info": { "title": "Zero Infinity Product Access", "version": "v1" },
  "paths": {
    "/health": { "get": { "responses": { "200": { "$ref": "#/components/responses/Health" } } } },
    "/capabilities": { "get": { "responses": { "200": { "$ref": "#/components/responses/Capabilities" } } } },
    "/readiness": { "get": { "responses": { "200": { "$ref": "#/components/responses/Readiness" } } } },
    "/v1/reasoning-stacks": { "post": { "description": "Register a validated frozen ReasoningStackConfig. Credentials are rejected; use server runtime configuration.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReasoningStackConfig" } } } }, "responses": { "201": { "description": "Registered stack", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StackSummary" } } } }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/advisory": { "post": { "description": "Run canonical reasoning and return a bounded no-write ExecutionMandate for external use.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdvisoryRequest" } } } }, "responses": { "200": { "description": "Advisory mandate or fail-closed refusal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdvisoryResult" } } } }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Opportunity" } } } }, "responses": { "201": { "$ref": "#/components/responses/Workflow" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows/{workflowId}": { "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }], "get": { "responses": { "200": { "$ref": "#/components/responses/Workflow" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows/{workflowId}/submit": { "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }], "post": { "responses": { "200": { "$ref": "#/components/responses/WorkflowResult" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows/{workflowId}/receipt": { "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }], "get": { "responses": { "200": { "description": "Reasoning receipt", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows/{workflowId}/thesis": { "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }], "get": { "responses": { "200": { "description": "Trade thesis", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/workflows/{workflowId}/mandate": { "parameters": [{ "$ref": "#/components/parameters/WorkflowId" }], "get": { "responses": { "200": { "description": "Portable execution mandate", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/shadow": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Opportunity" } } } }, "responses": { "200": { "$ref": "#/components/responses/WorkflowResult" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/v1/paper-live": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Opportunity" } } } }, "responses": { "200": { "$ref": "#/components/responses/PaperLiveResult" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/mcp": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcRequest" } } } }, "responses": { "200": { "description": "JSON-RPC response", "content": { "application/json": { "schema": { "type": "object", "required": ["jsonrpc", "id"], "properties": { "jsonrpc": { "type": "string", "const": "2.0" }, "id": {}, "result": {}, "error": { "type": "object" } } } } } } } } }
  },
  "components": {
    "parameters": { "WorkflowId": { "name": "workflowId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } } },
    "schemas": {
      "Opportunity": { "type": "object", "additionalProperties": true, "description": "Plain JSON object. Must not be an array, contain accessors, or rely on inherited fields." },
      "Health": { "type": "object", "required": ["ok", "version"], "properties": { "ok": { "type": "boolean", "const": true }, "version": { "type": "string" } } },
      "Capabilities": { "type": "object", "required": ["version", "roles", "capabilities", "writes", "authority"], "properties": { "version": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" } }, "capabilities": { "type": "array", "items": { "type": "string" } }, "writes": { "type": "array", "items": {} }, "authority": { "type": "boolean" } } },
      "Readiness": { "type": "object", "required": ["version", "ready", "mode", "liveWrites", "hostedEvidence"], "properties": { "version": { "type": "string" }, "ready": { "type": "boolean" }, "mode": { "type": "string" }, "liveWrites": { "type": "boolean" }, "hostedEvidence": { "type": "boolean" } } },
      "ReasoningStackConfig": { "type": "object", "required": ["name", "version", "advocate", "opposer", "marketAnalyst", "council"], "additionalProperties": false, "description": "Frozen stack configuration. Do not include credentials; endpoint/API provider secrets belong to server runtime configuration." },
      "StackSummary": { "type": "object", "required": ["name", "version", "capabilities", "composition"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "string" } }, "composition": { "type": "array", "items": { "type": "object" } } } },
      "AdvisoryRequest": { "type": "object", "required": ["opportunity", "compilerPolicy", "anchor"], "properties": { "opportunity": { "$ref": "#/components/schemas/Opportunity" }, "compilerPolicy": { "type": "object" }, "anchor": { "type": "object", "required": ["stateVersion", "observedAt", "receivedAt", "markPrice"], "properties": { "stateVersion": { "oneOf": [{ "type": "string", "pattern": "^[0-9]+n$" }, { "type": "integer" }] }, "observedAt": { "type": "number" }, "receivedAt": { "type": "number" }, "markPrice": { "type": "number" } } } } },
      "AdvisoryResult": { "type": "object", "required": ["version", "mode", "noWrite", "workflowId", "status", "result"], "properties": { "version": { "type": "string" }, "mode": { "type": "string", "const": "ADVISORY" }, "noWrite": { "type": "boolean", "const": true }, "workflowId": { "type": "string" }, "status": { "type": "string" }, "mandate": { "type": "object" }, "thesis": { "type": "object" }, "receipt": { "type": "object" }, "result": { "$ref": "#/components/schemas/WorkflowResult" } } },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Workflow": { "type": "object", "required": ["workflowId", "stackName", "stackVersion", "createdAt", "status", "opportunity", "composition"], "properties": { "workflowId": { "type": "string" }, "stackName": { "type": "string" }, "stackVersion": { "type": "string" }, "createdAt": { "type": "number" }, "status": { "type": "string", "enum": ["CREATED", "COMPLETE", "REASONING_INCOMPLETE", "REFUSE"] }, "opportunity": { "$ref": "#/components/schemas/Opportunity" }, "composition": { "type": "array", "items": { "type": "object" } } } },
      "WorkflowResult": { "type": "object", "required": ["workflow"], "properties": { "workflow": { "$ref": "#/components/schemas/Workflow" }, "thesis": { "type": "object" } } },
      "PaperLiveResult": { "type": "object", "required": ["version", "mode", "noWrite", "workflowId", "status", "result", "paperReceipt"], "properties": { "version": { "type": "string" }, "mode": { "type": "string", "const": "PAPER_LIVE" }, "noWrite": { "type": "boolean", "const": true }, "workflowId": { "type": "string" }, "status": { "type": "string" }, "result": { "$ref": "#/components/schemas/WorkflowResult" }, "paperReceipt": { "type": "object" } } },
      "JsonRpcRequest": { "type": "object", "required": ["jsonrpc", "id", "method"], "properties": { "jsonrpc": { "type": "string", "const": "2.0" }, "id": {}, "method": { "type": "string" }, "params": { "type": "object", "additionalProperties": true } } }
    },
    "responses": {
      "Health": { "description": "Healthy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
      "Capabilities": { "description": "Bounded capabilities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } },
      "Readiness": { "description": "Local bounded readiness", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } },
      "Workflow": { "description": "Workflow record", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workflow" } } } },
      "WorkflowResult": { "description": "Workflow result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowResult" } } } },
      "Error": { "description": "Error contract", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "PaperLiveResult": { "description": "Deterministic PAPER_LIVE no-write result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaperLiveResult" } } } }
    }
  },
  "x-mcp": { "tools": ["tools/list", "get_capabilities", "get_readiness", "register_reasoning_stack", "run_advisory", "get_mandate", "create_workflow", "submit_opportunity", "get_reasoning_receipt", "get_trade_thesis", "run_shadow_workflow", "run_paper_live", "get_workflow"], "resources": ["resources/list", "resources/read"] },
  "x-runtime-modes": { "SHADOW": true, "PAPER_LIVE": true, "BINANCE_TESTNET": false, "LIVE_CONFIRMED": false },
  "x-writes": []
}
