{
  "name": "0-infinity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sdk": "./dist/src/product/sdk.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "shadow:campaign": "npm run build && node dist/src/shadow/mb7Campaign.js",
    "evidence:mb7": "npm run build && node dist/src/shadow/mb7Evidence.js",
    "demo": "npm run build && node dist/src/readiness/cli.js demo",
    "readiness:validate": "npm run build && node dist/src/readiness/cli.js validate",
    "evidence:validate": "npm run readiness:validate",
    "secret-scan": "npm run build && node dist/src/readiness/cli.js secret-scan",
    "api": "npm run build && node dist/src/product/server.js",
    "mcp": "npm run build && node dist/src/product/mcp-server.js",
    "web:check": "npm run build && node --test dist/tests/productization.ui.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
