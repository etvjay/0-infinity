{
  "name": "0-infinity",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "types": "./dist/src/product/index.d.ts",
  "files": ["dist", "docs", "examples"],
  "exports": {
    "./sdk": { "types": "./dist/src/product/sdk.d.ts", "import": "./dist/src/product/sdk.js" },
    "./product": { "types": "./dist/src/product/index.d.ts", "import": "./dist/src/product/index.js" },
    "./reasoning": { "types": "./dist/src/reasoning/index.d.ts", "import": "./dist/src/reasoning/index.js" },
    "./mandate": { "types": "./dist/src/mandate/index.d.ts", "import": "./dist/src/mandate/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "rehearsal:external-model": "npm run build && node --test dist/tests/external-model.rehearsal.test.js",
    "shadow:campaign": "npm run build && node dist/src/shadow/mb7Campaign.js",
    "evidence:mb7": "npm run build && node dist/src/shadow/mb7Evidence.js",
    "demo": "npm run build && node dist/src/readiness/cli.js demo",
    "readiness:validate": "npm run build && node dist/src/readiness/cli.js validate",
    "evidence:validate": "npm run readiness:validate",
    "secret-scan": "npm run build && node dist/src/readiness/cli.js secret-scan",
    "api": "npm run build && node dist/src/product/server.js",
    "mcp": "npm run build && node dist/src/product/mcp-server.js",
    "web:check": "npm run build && node --test dist/tests/productization.ui.test.js",
    "quickstart": "npm run demo && npm run readiness:validate",
    "judge:local": "bash scripts/judge-local.sh",
    "smoke:front-door": "node scripts/front-door-smoke.mjs",
    "smoke:hosted": "npm run build && npm run smoke:front-door && node scripts/sdk-mcp-smoke.mjs",
    "sdk:mcp:smoke": "npm run build && node scripts/sdk-mcp-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
